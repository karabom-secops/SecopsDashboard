PORT=3000

# PostgreSQL connection
# On Coolify: use the Postgres resource's internal hostname (shown on its page)
# and its generated user/password/database. Set these in the app's Environment
# Variables in Coolify, not in a committed file.
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=secops_db
PG_USER=secops_user
PG_PASSWORD=CHANGE_ME

# Session secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Seed admin credentials (used by: node db/seed.js)
SEED_USERNAME=admin
SEED_PASSWORD=CHANGE_ME

# Set to production on the server to enable secure cookies (the Dockerfile sets it)
# NODE_ENV=production

# Report archive location. Defaults to data/reports, which sits on the
# /app/data persistent volume in the Coolify deployment.
# REPORT_ARCHIVE_DIR=/app/data/reports
